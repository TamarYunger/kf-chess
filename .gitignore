# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
.coverage.*
.tox/
# htmlcov/ is intentionally committed as a browsable coverage report

# Local server data
server/*.db
server/logs/
*.log

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local machine-specific TLS-interception CA certs for Docker builds
# (e.g. a corporate/filtering proxy) — never portable across machines.
certs/*.crt
